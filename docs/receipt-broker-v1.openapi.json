{
  "openapi": "3.1.0",
  "info": {
    "title": "Tyrion Receipt Broker",
    "version": "1.0.0",
    "description": "Private broker-only creation and reconciliation of one Monarch receipt for an already-canonical OWL document."
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/api/internal/v1/finance/receipt-broker/replicas": {
      "post": {
        "operationId": "submitReceiptBrokerReplicaV1",
        "summary": "Create or return one idempotent Monarch receipt replica",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 16,
              "maxLength": 160,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
            }
          },
          {
            "name": "X-OWL-Canonical-Document-Ref",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
            }
          },
          {
            "name": "X-OWL-Source-Ref",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
            }
          },
          {
            "name": "X-Tyrion-Expected-Revision",
            "in": "header",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9999999999
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/pdf": {
              "schema": {
                "type": "string",
                "format": "binary",
                "maxLength": 2097152
              }
            },
            "image/jpeg": {
              "schema": {
                "type": "string",
                "format": "binary",
                "maxLength": 2097152
              }
            },
            "image/png": {
              "schema": {
                "type": "string",
                "format": "binary",
                "maxLength": 2097152
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Bounded Monarch receipt broker status and evidence",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReceiptBrokerResponseV1"
                }
              }
            }
          },
          "201": {
            "description": "Bounded Monarch receipt broker status and evidence",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReceiptBrokerResponseV1"
                }
              }
            }
          },
          "202": {
            "description": "Bounded Monarch receipt broker status and evidence",
