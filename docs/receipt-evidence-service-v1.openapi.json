  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "ReceiptEvidenceResponseV1": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "receiptContractVersion",
          "intake",
          "replicaRef",
          "replicaLifecycle",
          "revision",
          "nativeEvidence",
          "reviewRequired",
          "reasonCodes"
        ],
        "properties": {
          "receiptContractVersion": {
            "const": "1.0"
          },
          "intake": {
            "type": "object"
          },
          "replicaRef": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 160
          },
          "replicaLifecycle": {
            "type": "string"
          },
          "revision": {
            "type": "integer",
            "minimum": 0
          },
          "nativeEvidence": {
            "type": [
              "object",
              "null"
            ]
          },
          "reviewRequired": {
            "type": "boolean"
          },
          "reasonCodes": {
            "type": "array",
            "maxItems": 12,
            "items": {
              "type": "string",
              "maxLength": 80
            }
          }
        }
      }
    }
