{
  "openapi": "3.1.0",
  "info": {
    "title": "Tyrion Internal Attribution Service",
    "version": "2.0.0",
    "description": "Private trusted-homelab service contract. Mission Control sends only privacy-safe normalized attribution facts; Tyrion derives the fixed household and service actor from its server implementation."
  },
  "servers": [
    {
      "url": "http://tyrion-operations-ui:3000",
      "description": "Private backend-network DNS only"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "The server-only BRIDGE_API_TOKEN shared by Tyrion and the Mission Control finance-manager backend on the private Docker network."
      }
    }
  },
  "paths": {
    "/api/internal/v2/attribution/policy": {
      "get": {
        "operationId": "getAttributionPolicyV2",
        "summary": "Discover the active attribution policy version",
        "description": "Returns only the active contract, engine, and policy version metadata. Policy rules, kids, account defaults, merchant rules, and household identity are never exposed. This route uses the same fixed private authority, bearer credential, and service actor as batch attribution.",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "The active policy version metadata.",
            "headers": {
              "Cache-Control": {
                "required": true,
                "schema": { "const": "no-store" }
              }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/$defs/AttributionPolicyResponseV2" }
              }
            }
          },
          "401": { "$ref": "#/$defs/AuthResponse" },
          "403": { "$ref": "#/$defs/ForbiddenResponse" },
          "404": { "$ref": "#/$defs/RouteResponse" },
          "500": { "$ref": "#/$defs/OperationFailureResponse" },
          "503": { "$ref": "#/$defs/UnavailableResponse" }
        }
      }
    },
    "/api/internal/v2/attribution/batch": {
      "post": {
        "operationId": "attributeBatchV2",
        "summary": "Attribute a bounded transaction batch using one current policy snapshot",
        "description": "Maximum body size is 65536 bytes. This route requires the fixed private service authority in Host and, when present, x-forwarded-host. It is excluded from every public operational UI router.",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/$defs/AttributionBatchRequestV2" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The complete batch was evaluated deterministically.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/$defs/AttributionBatchResponseV2" }
              }
            }
          },
          "400": { "$ref": "#/$defs/InvalidRequestResponse" },
          "401": { "$ref": "#/$defs/AuthResponse" },
          "403": { "$ref": "#/$defs/ForbiddenResponse" },
          "404": { "$ref": "#/$defs/RouteResponse" },
          "409": { "$ref": "#/$defs/ConflictResponse" },
          "413": { "$ref": "#/$defs/SizeResponse" },
          "415": { "$ref": "#/$defs/MediaTypeResponse" },
          "500": { "$ref": "#/$defs/OperationFailureResponse" },
          "503": { "$ref": "#/$defs/UnavailableResponse" }
        }
      }
    },
    "/api/internal/v2/attribution/actions": {
      "post": {
        "operationId": "applyAttributionActionV2",
        "summary": "Explain or mutate one versioned attribution exception",
        "description": "Read-only explain requests do not require confirmation. Assign/correct, parent-expense, unassign, resolve, and defer mutations require confirm=true, an idempotency key, and the expected consumer-owned state version.",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/$defs/AttributionActionRequestV2" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Current explanation and bounded actions, or the applied/replayed mutation with audit state.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/$defs/AttributionActionResponseV2" }
              }
            }
          },
          "400": { "$ref": "#/$defs/InvalidRequestResponse" },
          "401": { "$ref": "#/$defs/AuthResponse" },
          "403": { "$ref": "#/$defs/ForbiddenResponse" },
          "404": { "$ref": "#/$defs/RouteResponse" },
          "409": { "$ref": "#/$defs/ConflictResponse" },
          "413": { "$ref": "#/$defs/SizeResponse" },
          "415": { "$ref": "#/$defs/MediaTypeResponse" },
          "422": { "$ref": "#/$defs/ActionValidationResponse" },
          "500": { "$ref": "#/$defs/OperationFailureResponse" },
          "503": { "$ref": "#/$defs/UnavailableResponse" }
        }
      }
    },
    "/api/internal/v2/attribution/rules": {
      "post": {
        "operationId": "createMerchantAttributionRuleV2",
        "summary": "Create one explicitly confirmed merchant attribution rule",
        "description": "Creates one enabled rule under an optimistic policy-version fence. The body idempotency key derives a stable rule ID. Exact retries replay; changed reuse and stale new writes conflict. Confirmation must be fresh.",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/$defs/MerchantRuleCreationRequestV2" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The rule was created or an exact prior result was replayed.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/$defs/MerchantRuleCreationResponseV2" }
              }
            }
          },
          "400": { "$ref": "#/$defs/InvalidRequestResponse" },
          "401": { "$ref": "#/$defs/AuthResponse" },
          "403": { "$ref": "#/$defs/ForbiddenResponse" },
          "404": { "$ref": "#/$defs/RouteResponse" },
          "409": { "$ref": "#/$defs/ConflictResponse" },
          "413": { "$ref": "#/$defs/SizeResponse" },
          "415": { "$ref": "#/$defs/MediaTypeResponse" },
          "422": { "$ref": "#/$defs/ActionValidationResponse" },
          "500": { "$ref": "#/$defs/OperationFailureResponse" },
          "503": { "$ref": "#/$defs/UnavailableResponse" }
        }
      }
    }
  },
  "$defs": {
    "Identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time",
      "minLength": 20,
      "maxLength": 35
    },
    "AccountRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "description": "The exact case-sensitive id from the normalized Tyrion Bridge Account DTO. Consumers must not hash, namespace, or privately derive it."
    },
    "ManualDecisionV1": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["action", "kidId", "decidedAt"],
          "properties": {
            "action": { "const": "assign-kid" },
            "kidId": { "$ref": "#/$defs/Identifier" },
            "decidedAt": { "$ref": "#/$defs/Timestamp" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["action", "kidId", "decidedAt"],
          "properties": {
            "action": { "const": "parent-expense" },
            "kidId": { "type": "null" },
            "decidedAt": { "$ref": "#/$defs/Timestamp" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["action", "kidId", "decidedAt"],
          "properties": {
            "action": { "const": "unassign" },
            "kidId": { "type": "null" },
            "decidedAt": { "$ref": "#/$defs/Timestamp" }
          }
        }
      ]
    },
    "AttributionBatchItemV2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceRef",
        "occurredOn",
        "merchantName",
        "accountRef",
        "observedAt",
        "existingManualDecision"
      ],
      "properties": {
        "sourceRef": { "$ref": "#/$defs/Identifier" },
        "occurredOn": {
          "type": "string",
          "format": "date",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "merchantName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "businessEntityName": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 160,
          "description": "Optional normalized business-entity display label; never an upstream identifier or raw object."
        },
        "accountRef": {
          "$ref": "#/$defs/AccountRef"
        },
        "observedAt": { "$ref": "#/$defs/Timestamp" },
        "existingManualDecision": { "$ref": "#/$defs/ManualDecisionV1" }
      }
    },
    "AttributionBatchRequestV2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "provenance",
        "expectedPolicyVersion",
        "items"
      ],
      "properties": {
        "contractVersion": { "const": "2.0" },
        "provenance": { "const": "mission-control-normalized-v2" },
        "expectedPolicyVersion": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": { "$ref": "#/$defs/AttributionBatchItemV2" }
        }
      }
    },
    "MerchantRuleDraftV2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome",
        "kidId",
        "pattern",
        "businessEntityPattern",
        "scope",
        "accountRefs",
        "confidence"
      ],
      "properties": {
        "outcome": { "enum": ["kid", "parent-shared", "review"] },
        "kidId": {
          "oneOf": [
            { "$ref": "#/$defs/Identifier" },
            { "type": "null" }
          ],
          "description": "Required only for kid outcome; null otherwise."
        },
        "pattern": {
          "type": "string",
          "minLength": 2,
          "maxLength": 160
        },
        "businessEntityPattern": {
          "type": ["string", "null"],
          "minLength": 2,
          "maxLength": 160
        },
        "scope": { "enum": ["global", "accounts"] },
        "accountRefs": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/AccountRef" },
          "description": "Empty for global scope; 1-32 references for accounts scope."
        },
        "confidence": { "enum": ["definite", "likely"] }
      }
    },
    "MerchantRuleV2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "outcome",
        "kidId",
        "pattern",
        "businessEntityPattern",
        "scope",
        "accountRefs",
        "confidence",
        "enabled"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/Identifier" },
        "outcome": { "enum": ["kid", "parent-shared", "review"] },
        "kidId": {
          "oneOf": [
            { "$ref": "#/$defs/Identifier" },
            { "type": "null" }
          ]
        },
        "pattern": { "type": "string", "minLength": 2, "maxLength": 160 },
        "businessEntityPattern": {
          "type": ["string", "null"],
          "minLength": 2,
          "maxLength": 160
        },
        "scope": { "enum": ["global", "accounts"] },
        "accountRefs": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/AccountRef" }
        },
        "confidence": { "enum": ["definite", "likely"] },
        "enabled": { "const": true }
      }
    },
    "MerchantRuleCreationRequestV2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "expectedPolicyVersion",
        "idempotencyKey",
        "confirmation",
        "rule"
      ],
      "properties": {
        "contractVersion": { "const": "2.0" },
        "expectedPolicyVersion": { "type": "integer", "minimum": 1 },
        "idempotencyKey": {
          "type": "string",
          "minLength": 8,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "confirmation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["confirmed", "confirmedAt"],
          "properties": {
            "confirmed": { "const": true },
            "confirmedAt": { "$ref": "#/$defs/Timestamp" }
          }
        },
        "rule": { "$ref": "#/$defs/MerchantRuleDraftV2" }
      }
    },
    "MerchantRuleCreationResponseV2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "outcome", "policyVersion", "rule"],
      "properties": {
        "contractVersion": { "const": "2.0" },
        "outcome": { "enum": ["created", "replayed"] },
        "policyVersion": { "type": "integer", "minimum": 1 },
        "rule": { "$ref": "#/$defs/MerchantRuleV2" }
      }
    },
    "AttributionBatchResultV2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "sourceRef",
        "status",
        "kidId",
        "confidence",
        "method",
        "explanation",
        "reviewStatus",
        "reasons",
        "decisionSource",
        "policyVersion",
        "engineVersion",
        "evaluatedAt"
      ],
      "properties": {
        "contractVersion": { "const": "2.0" },
        "sourceRef": { "$ref": "#/$defs/Identifier" },
        "status": {
          "enum": ["attributed", "unassigned", "pending"]
        },
        "kidId": {
          "oneOf": [
            { "$ref": "#/$defs/Identifier" },
            { "type": "null" }
          ]
        },
        "confidence": { "enum": ["definite", "likely", "none"] },
        "method": {
          "enum": [
            "manual",
            "account-default",
            "merchant-rule",
            "historical-pattern",
            "unassigned",
            "unavailable"
          ]
        },
        "explanation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "reviewStatus": {
          "enum": ["not-required", "pending", "resolved"]
        },
        "reasons": {
          "type": "array",
          "items": {
            "enum": [
              "no-match",
              "low-confidence",
              "merchant-rule-conflict",
              "merchant-rule-review",
              "historical-attribution-tie",
              "engine-unavailable",
              "policy-unavailable",
              "policy-version-mismatch"
            ]
          }
        },
        "decisionSource": {
          "enum": ["manual", "automated", "fallback"]
        },
        "policyVersion": { "type": "integer", "minimum": 1 },
        "engineVersion": { "const": "2.0.0" },
        "evaluatedAt": { "$ref": "#/$defs/Timestamp" }
      }
    },
    "AttributionBatchResponseV2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "policyVersion",
        "engineVersion",
        "results"
      ],
      "properties": {
        "contractVersion": { "const": "2.0" },
        "policyVersion": { "type": "integer", "minimum": 1 },
        "engineVersion": { "const": "2.0.0" },
        "results": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": { "$ref": "#/$defs/AttributionBatchResultV2" }
        }
      }
    },
    "AttributionPolicyResponseV2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "engineVersion",
        "policyVersion",
        "policyUpdatedAt"
      ],
      "properties": {
        "contractVersion": { "const": "2.0" },
        "engineVersion": { "const": "2.0.0" },
        "policyVersion": { "type": "integer", "minimum": 1 },
        "policyUpdatedAt": { "$ref": "#/$defs/Timestamp" }
      }
    },
    "AttributionActionRequestV2": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["contractVersion", "provenance", "sourceRef", "expectedPolicyVersion", "action"],
          "properties": {
            "contractVersion": { "const": "2.0" },
            "provenance": { "const": "mission-control-normalized-v2" },
            "sourceRef": { "$ref": "#/$defs/Identifier" },
            "expectedPolicyVersion": { "type": "integer", "minimum": 1 },
            "action": { "const": "explain" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["contractVersion", "provenance", "sourceRef", "expectedPolicyVersion", "action", "expectedStateVersion", "idempotencyKey", "confirm", "kidId"],
          "properties": {
            "contractVersion": { "const": "2.0" },
            "provenance": { "const": "mission-control-normalized-v2" },
            "sourceRef": { "$ref": "#/$defs/Identifier" },
            "expectedPolicyVersion": { "type": "integer", "minimum": 1 },
            "action": { "const": "assign-kid" },
            "expectedStateVersion": { "type": "integer", "minimum": 1 },
            "idempotencyKey": { "$ref": "#/$defs/Identifier" },
            "confirm": { "const": true },
            "kidId": { "$ref": "#/$defs/Identifier" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["contractVersion", "provenance", "sourceRef", "expectedPolicyVersion", "action", "expectedStateVersion", "idempotencyKey", "confirm"],
          "properties": {
            "contractVersion": { "const": "2.0" },
            "provenance": { "const": "mission-control-normalized-v2" },
            "sourceRef": { "$ref": "#/$defs/Identifier" },
            "expectedPolicyVersion": { "type": "integer", "minimum": 1 },
            "action": { "enum": ["mark-parent-expense", "unassign", "resolve-exception"] },
            "expectedStateVersion": { "type": "integer", "minimum": 1 },
            "idempotencyKey": { "$ref": "#/$defs/Identifier" },
            "confirm": { "const": true }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["contractVersion", "provenance", "sourceRef", "expectedPolicyVersion", "action", "expectedStateVersion", "idempotencyKey", "confirm", "deferUntil"],
          "properties": {
            "contractVersion": { "const": "2.0" },
            "provenance": { "const": "mission-control-normalized-v2" },
            "sourceRef": { "$ref": "#/$defs/Identifier" },
            "expectedPolicyVersion": { "type": "integer", "minimum": 1 },
            "action": { "const": "defer-exception" },
            "expectedStateVersion": { "type": "integer", "minimum": 1 },
            "idempotencyKey": { "$ref": "#/$defs/Identifier" },
            "confirm": { "const": true },
            "deferUntil": { "$ref": "#/$defs/Timestamp" }
          }
        }
      ]
    },
    "AttributionActionResultV2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "sourceRef", "status", "kidId", "confidence", "method", "explanation", "review", "provenance"],
      "properties": {
        "contractVersion": { "const": "2.0" },
        "sourceRef": { "$ref": "#/$defs/Identifier" },
        "status": { "enum": ["attributed", "unassigned", "pending"] },
        "kidId": {
          "oneOf": [
            { "$ref": "#/$defs/Identifier" },
            { "type": "null" }
          ]
        },
        "confidence": { "enum": ["definite", "likely", "none"] },
        "method": { "enum": ["manual", "account-default", "merchant-rule", "historical-pattern", "unassigned", "unavailable"] },
        "explanation": { "type": "string", "minLength": 1, "maxLength": 300 },
        "review": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "reasons"],
          "properties": {
            "status": { "enum": ["not-required", "pending", "resolved"] },
            "reasons": {
              "type": "array",
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/AttributionReviewReasonV2" }
            }
          }
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["decisionSource", "policyVersion", "engineVersion", "ruleIds", "evaluatedAt"],
          "properties": {
            "decisionSource": { "enum": ["manual", "automated", "fallback"] },
            "policyVersion": {
              "oneOf": [
                { "type": "integer", "minimum": 1 },
                { "type": "null" }
              ]
            },
            "engineVersion": { "const": "2.0.0" },
            "ruleIds": {
              "type": "array",
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/Identifier" }
            },
            "evaluatedAt": { "$ref": "#/$defs/Timestamp" }
          }
        }
      }
    },
    "AttributionReviewReasonV2": {
      "enum": [
        "no-match",
        "low-confidence",
        "merchant-rule-conflict",
        "merchant-rule-review",
        "historical-attribution-tie",
        "engine-unavailable",
        "policy-unavailable",
        "policy-version-mismatch"
      ]
    },
    "AttributionExceptionStateV2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reasons", "deferredUntil", "updatedAt"],
      "properties": {
        "status": { "enum": ["open", "resolved", "deferred"] },
        "reasons": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/AttributionReviewReasonV2" }
        },
        "deferredUntil": {
          "oneOf": [
            { "$ref": "#/$defs/Timestamp" },
            { "type": "null" }
          ]
        },
        "updatedAt": { "$ref": "#/$defs/Timestamp" }
      }
    },
    "AttributionActionAuditV2": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["actionRef", "idempotencyKey", "action", "actorId", "outcome", "previousStateVersion", "stateVersion", "policyVersion", "appliedAt"],
          "properties": {
            "actionRef": { "$ref": "#/$defs/Identifier" },
            "idempotencyKey": { "$ref": "#/$defs/Identifier" },
            "action": { "enum": ["assign-kid", "mark-parent-expense", "unassign", "resolve-exception", "defer-exception"] },
            "actorId": { "$ref": "#/$defs/Identifier" },
            "outcome": { "enum": ["applied", "replayed"] },
            "previousStateVersion": { "type": "integer", "minimum": 1 },
            "stateVersion": { "type": "integer", "minimum": 2 },
            "policyVersion": { "type": "integer", "minimum": 1 },
            "appliedAt": { "$ref": "#/$defs/Timestamp" }
          }
        }
      ]
    },
    "AttributionActionResponseV2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "sourceRef", "policyVersion", "engineVersion", "stateVersion", "attribution", "exception", "availableActions", "assignableKidIds", "authoritativeDeepLink", "provenance", "audit"],
      "properties": {
        "contractVersion": { "const": "2.0" },
        "sourceRef": { "$ref": "#/$defs/Identifier" },
        "policyVersion": { "type": "integer", "minimum": 1 },
        "engineVersion": { "const": "2.0.0" },
        "stateVersion": { "type": "integer", "minimum": 1 },
        "attribution": { "$ref": "#/$defs/AttributionActionResultV2" },
        "exception": { "$ref": "#/$defs/AttributionExceptionStateV2" },
        "availableActions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": ["explain", "assign-kid", "mark-parent-expense", "unassign", "resolve-exception", "defer-exception", "open-in-monarch"]
          }
        },
        "assignableKidIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/Identifier" }
        },
        "authoritativeDeepLink": {
          "type": "object",
          "additionalProperties": false,
          "required": ["system", "target", "sourceRef"],
          "properties": {
            "system": { "const": "monarch" },
            "target": { "const": "transaction" },
            "sourceRef": { "$ref": "#/$defs/Identifier" }
          }
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sourceSystem", "normalizedBy", "decidedBy", "decisionSource", "evaluatedAt"],
          "properties": {
            "sourceSystem": { "const": "monarch" },
            "normalizedBy": { "const": "monarch-bridge" },
            "decidedBy": { "const": "tyrion" },
            "decisionSource": { "enum": ["manual", "automated", "fallback"] },
            "evaluatedAt": { "$ref": "#/$defs/Timestamp" }
          }
        },
        "audit": { "$ref": "#/$defs/AttributionActionAuditV2" }
      }
    },
    "ErrorBody": {
      "type": "object",
      "additionalProperties": false,
      "required": ["error"],
      "properties": {
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message"],
          "properties": {
            "code": { "type": "string" },
            "message": { "type": "string" }
          }
        }
      }
    },
    "InvalidRequestResponse": {
      "description": "invalid_request",
      "content": {
        "application/json": { "schema": { "$ref": "#/$defs/ErrorBody" } }
      }
    },
    "AuthResponse": {
      "description": "attribution_auth_required or attribution_auth_invalid",
      "content": {
        "application/json": { "schema": { "$ref": "#/$defs/ErrorBody" } }
      }
    },
    "ForbiddenResponse": {
      "description": "attribution_forbidden",
      "content": {
        "application/json": { "schema": { "$ref": "#/$defs/ErrorBody" } }
      }
    },
    "RouteResponse": {
      "description": "attribution_route_not_available or attribution_not_found",
      "content": {
        "application/json": { "schema": { "$ref": "#/$defs/ErrorBody" } }
      }
    },
    "ConflictResponse": {
      "description": "policy_conflict, attribution_state_conflict, idempotency_conflict, or action_not_available",
      "content": {
        "application/json": { "schema": { "$ref": "#/$defs/ErrorBody" } }
      }
    },
    "SizeResponse": {
      "description": "payload_too_large or batch_too_large",
      "content": {
        "application/json": { "schema": { "$ref": "#/$defs/ErrorBody" } }
      }
    },
    "MediaTypeResponse": {
      "description": "unsupported_media_type",
      "content": {
        "application/json": { "schema": { "$ref": "#/$defs/ErrorBody" } }
      }
    },
    "OperationFailureResponse": {
      "description": "attribution_operation_failed",
      "content": {
        "application/json": { "schema": { "$ref": "#/$defs/ErrorBody" } }
      }
    },
    "ActionValidationResponse": {
      "description": "kid_not_assignable or invalid_defer_window",
      "content": {
        "application/json": { "schema": { "$ref": "#/$defs/ErrorBody" } }
      }
    },
    "UnavailableResponse": {
      "description": "attribution_auth_not_configured, policy_unavailable, attribution_state_unavailable, attribution_state_invalid, or attribution_service_unavailable",
      "content": {
        "application/json": { "schema": { "$ref": "#/$defs/ErrorBody" } }
      }
    }
  }
}
