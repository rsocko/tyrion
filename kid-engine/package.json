{
  "name": "@rsocko/tyrion-kid-engine",
  "version": "2.0.0",
  "private": true,
  "license": "MIT",
  "description": "Tyrion-internal household policy and kid attribution domain module",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./contracts/v1": {
      "types": "./dist/contracts/v1.d.ts",
      "import": "./dist/contracts/v1.js"
    },
    "./contracts/v2": {
      "types": "./dist/contracts/v1.d.ts",
      "import": "./dist/contracts/v1.js"
    },
    "./policy": {
      "types": "./dist/policy/index.d.ts",
      "import": "./dist/policy/index.js"
    }
  },
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "proper-lockfile": "4.1.2"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit": "python ../.github/scripts/check_npm_audit_policy.py kid-engine"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/proper-lockfile": "^4.1.4",
    "typescript": "^5.5.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "nanoid": "3.3.16",
    "postcss": "8.5.25"
  }
}
