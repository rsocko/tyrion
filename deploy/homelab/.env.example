# Public production repositories follow latest by default. Set one shared tag to a
# published build-N, main, latest, or sha-<40-character-commit> tag for both services.
TYRION_BRIDGE_IMAGE=ghcr.io/rsocko/tyrion-bridge
TYRION_UI_IMAGE=ghcr.io/rsocko/tyrion-ui
TYRION_IMAGE_TAG=latest

# Deployment-specific hostname and allowed browser origin.
TYRION_HOSTNAME=[public-hostname]
BRIDGE_ALLOWED_ORIGINS=https://[allowed-browser-origin]

# Non-secret runtime tuning.
DEFAULT_TRANSACTION_DAYS=90
TYRION_BRIDGE_CPUS=1.0
TYRION_BRIDGE_MEMORY=512m
TYRION_UI_CPUS=0.5
TYRION_UI_MEMORY=256m
TYRION_SESSION_VOLUME=tyrion-session
TYRION_POLICY_VOLUME=tyrion-policy
TYRION_FINANCE_INSIGHT_VOLUME=tyrion-finance-insights
TYRION_BACKEND_NETWORK=tyrion-backend

# Provision one shared BRIDGE_API_TOKEN (minimum 32 characters) as a platform secret.
# The bridge and Mission Control attribution caller reuse it only for authentication
# on protected server paths. Mission Control also sends it only from backend processes
# to the exact https://[public-hostname]/api/connector/v1 origin.
BRIDGE_API_TOKEN=

# Optional server-allowlisted return after connector recovery. Mission Control links to
# https://[public-hostname]/?source=mission-control and never supplies a return URL.
MISSION_CONTROL_RETURN_URL=https://[mission-control-host]/finance/settings
MISSION_CONTROL_RETURN_ALLOWED_ORIGINS=https://[mission-control-host]

# Optional internal re-attribution and attribution-action state service.
# Protected calls use BRIDGE_API_TOKEN; leave the URL blank until deployed.
TYRION_REATTRIBUTION_URL=

# Fail-closed rollout gates.
TYRION_FINANCE_INSIGHT_EVALUATION_WRITE_ENABLED=false
TYRION_FINANCE_INSIGHT_READ_ENABLED=false
TYRION_FINANCE_INSIGHT_ACTIONS_ENABLED=false
TYRION_FINANCE_AUTOMATION_WRITE_ENABLED=false
