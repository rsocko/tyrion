# Documentation defaults for the homelab parity stack. Do not add secret values.

# Required immutable image tag: sha- followed by 7-40 lowercase commit hex characters.
TYRION_IMAGE_TAG=sha-<7-40-lowercase-commit-hex>

# Private split-horizon hostname and allowed Mission Control origin.
TYRION_HOSTNAME=tyrion.socko.us
TYRION_BRIDGE_ALLOWED_ORIGINS=https://mc.socko.us

# Non-secret runtime tuning.
TYRION_DEFAULT_TRANSACTION_DAYS=90
TYRION_CPUS=1.0
TYRION_MEMORY=512m
TYRION_SESSION_VOLUME=tyrion-session

# Provision TYRION_BRIDGE_API_TOKEN externally as a Dockhand secret with at
# least 32 characters. Compose maps it to runtime BRIDGE_API_TOKEN.
