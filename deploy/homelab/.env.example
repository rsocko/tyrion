# Literal defaults for Docker Compose and Dockhand. Keep .env and .env.example
# identical and never add secret values.
TYRION_BRIDGE_IMAGE_TAG=latest
TYRION_UI_IMAGE_TAG=latest

# Private split-horizon hostname and allowed browser origin.
TYRION_HOSTNAME=tyrion.socko.us
BRIDGE_ALLOWED_ORIGINS=https://mc.socko.us

# Non-secret runtime tuning.
DEFAULT_TRANSACTION_DAYS=90
TYRION_BRIDGE_CPUS=1.0
TYRION_BRIDGE_MEMORY=512m
TYRION_UI_CPUS=0.5
TYRION_UI_MEMORY=256m
TYRION_SESSION_VOLUME=tyrion-session
TYRION_POLICY_VOLUME=tyrion-policy
TYRION_BACKEND_NETWORK=tyrion-backend

# Provision one shared BRIDGE_API_TOKEN (minimum 32 characters) as a Dockhand secret.
BRIDGE_API_TOKEN=

# Provision these as Dockhand secrets. The trusted auth service uses the same policy
# assertion secret but it must never expose that value to browsers.
TYRION_POLICY_AUTH_SECRET=
TYRION_INSTRUMENT_FINGERPRINT_KEY=
TYRION_REATTRIBUTION_TOKEN=
TYRION_ATTRIBUTION_AUTH_SECRET=

# Internal Mission Control attribution service scope. These are placeholders, not
# browser configuration. The route is reachable only by backend-network DNS.
TYRION_ATTRIBUTION_CLIENT_ID=[mission-control-client-id]
TYRION_ATTRIBUTION_ACTOR_ID=[server-derived-service-actor-id]
TYRION_ATTRIBUTION_HOUSEHOLD_ID=[authorized-household-id]

# Optional internal policy-application service. Leave blank until deployed.
TYRION_REATTRIBUTION_URL=

# Trusted forward-auth service that strips inbound assertion headers and signs the
# actor, household, permission, method, and path context for policy API requests.
TYRION_POLICY_AUTH_URL=
