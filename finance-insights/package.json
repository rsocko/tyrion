{
  "name": "@rsocko/tyrion-finance-insights",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "description": "Tyrion-private finance insight contracts and deterministic core",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./contracts/v1": {
      "types": "./dist/contracts/v1.d.ts",
      "import": "./dist/contracts/v1.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./policy": {
      "types": "./dist/policy/v1.d.ts",
      "import": "./dist/policy/v1.js"
    },
    "./ports": {
      "types": "./dist/ports/repositories.d.ts",
      "import": "./dist/ports/repositories.js"
    }
  },
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "generate:openapi": "npm run build && node scripts/generate-openapi.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "^5.5.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "nanoid": "3.3.16",
    "postcss": "8.5.25"
  }
}
