# Local server config (default and recommended)
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8100

# Optional explicit browser callers. The Next.js proxy is server-to-server.
BRIDGE_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Non-loopback deployments require all three values and TLS termination.
# BRIDGE_HOST=192.0.2.10
# BRIDGE_API_TOKEN=
# BRIDGE_REMOTE_TLS=true

# Optional external session path. Never place this inside a Git repository.
# SESSION_FILE=/secure/app-state/tyrion/monarch-bridge/session.json

# Loading a local .env file is opt-in to prevent test/process configuration leaks.
BRIDGE_LOAD_DOTENV=false

# Sync settings
DEFAULT_TRANSACTION_DAYS=90

# Optional Monarch-first receipt recovery one-shot. Keep disabled until OWL canonical
# intake is configured. Tokens remain process/deployment secrets and are not listed
# here. State must remain outside every repository.
TYRION_MONARCH_RECOVERY_ENABLED=false
# BRIDGE_URL=http://tyrion-monarch-bridge:8100
# OWL_RECEIPT_INTAKE_URL=http://owl-private-service:8000
# TYRION_RECEIPT_IDENTITY_NAMESPACE=
# TYRION_MONARCH_RECOVERY_STATE_FILE=/secure/app-state/tyrion/recovery/checkpoint.json
TYRION_MONARCH_RECOVERY_PAGE_SIZE=25
TYRION_MONARCH_RECOVERY_MAX_PAGES=20
TYRION_MONARCH_RECOVERY_MAX_ITEMS=500
TYRION_MONARCH_RECOVERY_MAX_BYTES=2097152
TYRION_MONARCH_RECOVERY_TIMEOUT_SECONDS=45
