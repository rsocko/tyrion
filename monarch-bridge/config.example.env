# Monarch Money credentials
MONARCH_EMAIL=your@email.com
MONARCH_PASSWORD=your-password-here

# Optional: MFA secret for automated login (TOTP base32 key)
# MONARCH_MFA_SECRET=

# Server config
BRIDGE_HOST=0.0.0.0
BRIDGE_PORT=8100

# Session cache location
SESSION_FILE=~/.monarch_session

# Sync settings
DEFAULT_TRANSACTION_DAYS=90
