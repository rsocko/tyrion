# Local server config (default and recommended)
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8100

# Optional explicit browser callers. The Next.js proxy is server-to-server.
BRIDGE_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Production container defaults. Non-loopback deployments require the token and
# TLS termination; the token must be at least 32 characters and remain server-only.
# BRIDGE_HOST=0.0.0.0
# BRIDGE_PORT=8100
# BRIDGE_API_TOKEN=
# BRIDGE_REMOTE_TLS=true
# BRIDGE_ALLOWED_ORIGINS=https://mc.socko.us
# BRIDGE_LOAD_DOTENV=false
# DEFAULT_TRANSACTION_DAYS=90

# Canonical production mount and session path. Never place this inside a Git repository.
# SESSION_FILE=/var/lib/tyrion/monarch-session.json

# Loading a local .env file is opt-in to prevent test/process configuration leaks.
BRIDGE_LOAD_DOTENV=false

# Sync settings
DEFAULT_TRANSACTION_DAYS=90
