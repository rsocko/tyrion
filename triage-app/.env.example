# Server-only local bridge configuration. Never prefix the token with NEXT_PUBLIC_.
BRIDGE_URL=http://127.0.0.1:8100
BRIDGE_API_TOKEN=

# Policy configuration is fail-closed unless these server-only values are configured.
TYRION_POLICY_STORE_PATH=[absolute-external-policy-store-path]
TYRION_POLICY_AUTH_SECRET=
TYRION_INSTRUMENT_FINGERPRINT_KEY=

# Protected internal attribution service. Never prefix these with NEXT_PUBLIC_.
TYRION_ATTRIBUTION_CLIENT_ID=[mission-control-client-id]
TYRION_ATTRIBUTION_ACTOR_ID=[server-derived-service-actor-id]
TYRION_ATTRIBUTION_HOUSEHOLD_ID=[authorized-household-id]
TYRION_ATTRIBUTION_AUTH_SECRET=
TYRION_ATTRIBUTION_INTERNAL_HOST=[private-service-host:port]
TYRION_ATTRIBUTION_REPLAY_STORE_PATH=[absolute-external-replay-store-directory]

# Optional controlled re-attribution integration. Policy CRUD works without it.
TYRION_REATTRIBUTION_URL=[https://internal-reattribution-service/]
TYRION_REATTRIBUTION_TOKEN=
TYRION_REATTRIBUTION_ALLOW_INSECURE_INTERNAL=false

# Non-production deterministic mode only. Production rejects this mode.
TYRION_POLICY_DEMO_MODE=false
