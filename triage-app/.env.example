# Server-only local bridge configuration. The same minimum-32-character token
# authenticates backend calls to /api/connector/v1. Never prefix it with NEXT_PUBLIC_.
BRIDGE_URL=http://127.0.0.1:8100
BRIDGE_API_TOKEN=

# Optional exact post-recovery handoff. Both values are server-only configuration.
# The return URL must use one allowlisted HTTPS origin and cannot contain query or hash.
MISSION_CONTROL_RETURN_URL=https://[mission-control-host]/finance/settings
MISSION_CONTROL_RETURN_ALLOWED_ORIGINS=https://[mission-control-host]

# Policy configuration is fail-closed unless this external store and the shared
# BRIDGE_API_TOKEN above are configured.
TYRION_POLICY_STORE_PATH=[absolute-external-policy-store-path]

# Optional controlled re-attribution and attribution-action state integration.
# It uses BRIDGE_API_TOKEN above; policy CRUD and batch evaluation work without it.
TYRION_REATTRIBUTION_URL=[https://internal-attribution-state-service/]
TYRION_REATTRIBUTION_ALLOW_INSECURE_INTERNAL=false

# Non-production deterministic mode only. Production rejects this mode.
TYRION_POLICY_DEMO_MODE=false

# Protected finance-insight SQLite state. Production Compose supplies the internal
# path for its persistent volume; set an absolute external path only for local runs.
TYRION_FINANCE_INSIGHT_STORE_PATH=[absolute-finance-insight-store-path]

# Fail-closed server-only rollout gates.
TYRION_FINANCE_INSIGHT_EVALUATION_WRITE_ENABLED=false
TYRION_FINANCE_INSIGHT_READ_ENABLED=false
TYRION_FINANCE_INSIGHT_ACTIONS_ENABLED=false
TYRION_FINANCE_AUTOMATION_WRITE_ENABLED=false
